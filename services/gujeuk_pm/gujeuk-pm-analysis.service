[Unit]
Description=Gujeuk PM tool-free source analysis (existing Hermes profile)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/gujeuk-pm
ExecStart=/usr/bin/docker compose exec -T -u 1000:1000 -e PYTHONPATH=/opt/data/workspace/gujeuk-pm/src hermes /opt/hermes/.venv/bin/python -B -m oijwef098234.gujeuk_ai.runtime analyze --state /opt/data/pm-workspace
TimeoutStartSec=600
# Never print raw source/model responses. Runtime emits counts or sanitized errors.
StandardOutput=journal
StandardError=journal
